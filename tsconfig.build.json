{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "bootstrap/**/*.ts",
    "config/**/*.ts",
    "entrypoints/**/*.ts",
    "plugins/**/*.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "proofs",
    "wireframes",
    "plugins/**/tests",
    "plugins/**/*.tsx"
  ]
}
