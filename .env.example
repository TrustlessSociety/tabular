# Reference only: Tabular does not load .env files. Export these through the
# shell, process supervisor, or secret manager. Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=debug
TABULAR_INSTANCE_ID=local
TABULAR_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Supported Task 00014 local review uses a generated owner-only environment at
# .build/local-review/runtime.env. Its explicitly disposable human credentials
# are tabular_reviewer / review-local-only-2026. Do not reuse them on retained
# data or a non-loopback target.

# All three authorities must target the same PostgreSQL database. Production
# requires distinct login roles; the sample values are local-only placeholders.
TABULAR_DATABASE_CONNECTION_ID=local
TABULAR_WEB_DATABASE_URL=postgresql://tabular_web:local-only@127.0.0.1:5432/tabular
TABULAR_MIGRATOR_DATABASE_URL=postgresql://tabular_migrator:local-only@127.0.0.1:5432/tabular
TABULAR_WORKER_DATABASE_URL=postgresql://tabular_worker:local-only@127.0.0.1:5432/tabular
TABULAR_STATEMENT_TIMEOUT_MS=10000
TABULAR_POOL_MAXIMUM=10

TABULAR_HOST=127.0.0.1
TABULAR_PORT=3000
TABULAR_SHUTDOWN_TIMEOUT_MS=10000
TABULAR_REQUEST_TIMEOUT_MS=30000
TABULAR_HEADERS_TIMEOUT_MS=15000
TABULAR_KEEP_ALIVE_TIMEOUT_MS=5000
TABULAR_MAX_REQUEST_BODY_BYTES=1048576

TABULAR_SESSION_MAX_AGE_SECONDS=28800
TABULAR_SESSION_IDLE_TIMEOUT_SECONDS=1800

TABULAR_SSE_HEARTBEAT_MS=15000
TABULAR_SSE_REPLAY_LIMIT=1000
TABULAR_SSE_CLIENT_QUEUE_LIMIT=256
TABULAR_SSE_CONNECTION_LIMIT=1000
TABULAR_SSE_POLL_MS=250

TABULAR_WORKER_CONCURRENCY=2
TABULAR_WORKER_BATCH_SIZE=25
TABULAR_WORKER_LEASE_SECONDS=30
TABULAR_WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Optional local demo owner/grant. This must name an existing safe NOLOGIN role
# the migrator has SET membership in.
# TABULAR_DEMO_MEMBER_ROLE=tabular_member

# Optional Google Sheets integration. Supply all four through a secret manager.
# TABULAR_GOOGLE_CLIENT_ID=replace-in-deployment
# TABULAR_GOOGLE_CLIENT_SECRET=replace-in-deployment
# TABULAR_GOOGLE_REDIRECT_URI=https://tabular.example/events/import-google-callback
# TABULAR_GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
